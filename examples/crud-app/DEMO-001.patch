+    def test_list_filters_and_default_order(self) -> None:
+        tasks = [self.store.create(title) for title in ("Z", "Y", "X", "W")]
+        for index in (3, 1):
+            tasks[index] = self.store.update(tasks[index]["id"], None, True)
+        self.assertEqual(self.store.list(), tasks)
+        self.assertEqual(self.store.list(done=True), [tasks[1], tasks[3]])
+        self.assertEqual(self.store.list(done=False), [tasks[0], tasks[2]])
+
+    def test_list_empty_results(self) -> None:
+        for done in (None, True, False):
+            with self.subTest(done=done):
+                self.assertEqual(self.store.list(done=done), [])
+        task = self.store.create("Only task")
+        self.assertEqual(self.store.list(done=True), [])
+        self.store.update(task["id"], None, True)
+        self.assertEqual(self.store.list(done=False), [])
+
+    def run_list_cli(self, *flags: str) -> str:
+        result = subprocess.run(
+            [sys.executable, str(Path(__file__).with_name("tasks.py")),
+             "--db", str(self.path), "list", *flags],
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+        self.assertEqual(result.stderr, "")
+        return result.stdout
+
+    def test_list_cli_flags_and_default_order(self) -> None:
+        first = self.store.create("Z")
+        second = self.store.create("A")
+        second = self.store.update(second["id"], None, True)
+        for flags, expected in (
+            ((), [first, second]),
+            (("--done",), [second]),
+            (("--no-done",), [first]),
+        ):
+            with self.subTest(flags=flags):
+                self.assertEqual(json.loads(self.run_list_cli(*flags)), expected)
+
+    def test_list_cli_empty_results(self) -> None:
+        for flags in ((), ("--done",), ("--no-done",)):
+            with self.subTest(flags=flags):
+                self.assertEqual(self.run_list_cli(*flags).strip(), "[]")
+        task = self.store.create("Only task")
+        self.assertEqual(self.run_list_cli("--done").strip(), "[]")
+        self.store.update(task["id"], None, True)
+        self.assertEqual(self.run_list_cli("--no-done").strip(), "[]")
+
