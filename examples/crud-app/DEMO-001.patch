+import json
+import subprocess
+import sys
 import tempfile
 import unittest
 from pathlib import Path
@@ -32,6 +35,55 @@ class TaskStoreTests(unittest.TestCase):
             with self.assertRaisesRegex(ValueError, "not found"):
